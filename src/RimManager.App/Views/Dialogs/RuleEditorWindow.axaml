<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RimManager.App.ViewModels"
        x:Class="RimManager.App.Views.Dialogs.RuleEditorWindow"
        x:DataType="vm:RuleEditorViewModel"
        Title="Rule editor"
        Width="640" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RmBackgroundCanvasBrush}">
  <!--
    2i-5 · NON-modal, deliberately: this is a reference you keep open beside the load
    order while working out why something sits where it does, and a modal would put the
    list you are reasoning about behind it.
  -->
  <DockPanel Margin="14">

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="small ter"
               Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />

    <TextBlock DockPanel.Dock="Bottom" Classes="note" Margin="0,10,0,0"
               Text="{Binding PrecedenceNote}" />

    <Grid ColumnDefinitions="220,12,*">

      <!-- Left: the mods, with how many rules touch each. -->
      <DockPanel Grid.Column="0">
        <TextBox DockPanel.Dock="Top" Classes="inset" Margin="0,0,0,6"
                 AutomationProperties.Name="Filter mods" Text="{Binding Filter, Mode=TwoWay}"
                 PlaceholderText="filter mods" />
        <ToggleButton DockPanel.Dock="Top" Classes="pill" Margin="0,0,0,6"
                      Content="Only mods with rules"
                      IsChecked="{Binding WithRulesOnly, Mode=TwoWay}" />

        <Border Classes="pane">
          <ListBox Classes="dockRows" AutomationProperties.Name="Mods" ItemsSource="{Binding VisibleMods}"
                   SelectedItem="{Binding SelectedMod, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RuleModViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="pri"
                             VerticalAlignment="Center" Margin="8,0,0,0"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="small mono ter"
                             VerticalAlignment="Center" Margin="8,0,8,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <!-- Right: the rules for the selection, and the add row. -->
      <DockPanel Grid.Column="2" IsVisible="{Binding HasSelection}">
        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTitle}" Classes="title"
                   Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />

        <!-- Adding a rule of your own: direction, the other mod, and go. -->
        <Border DockPanel.Dock="Bottom" Classes="card" Padding="10,8" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="ADD YOUR OWN RULE" Classes="micro" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <!-- A segmented pair, not a pill (T6): a toggle whose OFF state means
                   "loads before" hides half its meaning — both directions deserve
                   their own words on screen. -->
              <Border Grid.Column="0" Classes="segmented" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="ruleDirection"
                               Content="loads after"
                               IsChecked="{Binding NewRuleLoadsAfter, Mode=TwoWay}" />
                  <RadioButton Classes="segment" GroupName="ruleDirection"
                               Content="loads before"
                               IsChecked="{Binding !NewRuleLoadsAfter, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <ComboBox Grid.Column="1" Margin="8,0" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Mod to relate to"
                        ItemsSource="{Binding Candidates}"
                        SelectedItem="{Binding NewRuleOther, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuleModViewModel">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2" Classes="accent" Content="Add"
                      Command="{Binding AddRuleCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="pane">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleRow">
                  <!-- A disabled rule keeps its row at reduced opacity; it is remembered,
                       never deleted, so a resync cannot quietly restore it. -->
                  <Border Classes="ruleRow" Classes.off="{Binding IsDisabled}"
                          BorderBrush="{DynamicResource RmBorderSubtleBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <!-- Grid, not a horizontal StackPanel: infinite width there means
                             a long mod name never ellipsizes and pushes the "yours" and
                             "locked" pills off the row, which are the two things that say
                             whether the rule can be edited at all. -->
                        <Grid ColumnDefinitions="Auto,6,*,6,Auto,6,Auto" ClipToBounds="True">
                          <TextBlock Grid.Column="0" Text="{Binding DirectionText}" Classes="small ter"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding OtherName}" Classes="pri"
                                     VerticalAlignment="Center" ToolTip.Tip="{Binding OtherName}"
                                     TextTrimming="CharacterEllipsis" />
                          <!-- Yours are accent-marked, because they beat everything else. -->
                          <Border Grid.Column="4" Classes="countPill accent" VerticalAlignment="Center"
                                  IsVisible="{Binding IsUserRule}">
                            <TextBlock Text="yours" Classes="small" />
                          </Border>
                          <Border Grid.Column="6" Classes="countPill" VerticalAlignment="Center"
                                  IsVisible="{Binding IsLocked}">
                            <TextBlock Text="locked" Classes="small ter" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding SourceText}" Classes="small mono ter" />
                        <TextBlock Text="{Binding Comment}" Classes="note"
                                   IsVisible="{Binding HasComment}" />
                      </StackPanel>

                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Center">
                        <Button Classes="quiet" Content="{Binding SwitchLabel}"
                                IsVisible="{Binding CanDisable}"
                                Command="{Binding $parent[Window].((vm:RuleEditorViewModel)DataContext).DisableRuleCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="quiet" Content="Remove"
                                IsVisible="{Binding CanDelete}"
                                Command="{Binding $parent[Window].((vm:RuleEditorViewModel)DataContext).DeleteRuleCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
