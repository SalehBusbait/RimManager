<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RimManager.App.ViewModels"
        x:Class="RimManager.App.Views.Dialogs.DescriptionWindow"
        x:DataType="vm:DescriptionViewerViewModel"
        Title="{Binding Title}"
        Width="560" Height="520"
        MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RmBackgroundCanvasBrush}">
  <!--
    O3 · the description the info pane clamps to four lines. Non-modal like every
    reference window (#4); read-only; Escape closes. It shares the image viewer's
    anatomy — 40px titled header, body, footer band — because they are the same kind
    of window and the four reference windows should not each invent their own.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="40" Padding="12,0"
            Background="{DynamicResource RmBackgroundAltBrush}"
            BorderBrush="{DynamicResource RmBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="{Binding Title}" Classes="title"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>

    <Border DockPanel.Dock="Bottom" Height="{DynamicResource RmDockFooterHeight}" Padding="12,0"
            Background="{DynamicResource RmBackgroundAltBrush}"
            BorderBrush="{DynamicResource RmBorderSubtleBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding FooterText}" Classes="mono ter" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- The gutter is a Margin on the content, never ScrollViewer.Padding: padding
           is SUBTRACTED from the scrollable extent, which is how a page once lost its
           last 32px (LayoutTrapTests). Selectable because the reason to open this
           window is often to copy a version number or a dependency name out of it. -->
      <SelectableTextBlock Text="{Binding Description}" Classes="small sec"
                           TextWrapping="Wrap" Margin="12" />
    </ScrollViewer>
  </DockPanel>
</Window>
