<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RimManager.App.ViewModels"
             x:Class="RimManager.App.Views.Shell.GameMissingView"
             x:DataType="vm:MainWindowViewModel"
             IsVisible="{Binding IsGameMissing}">
  <!--
    2k · STATE, GAME NOT FOUND. Like the first-scan state it covers the three panes and
    nothing else, so Settings, the menus and the instance selector all stay reachable —
    a full-window error would take away the very controls that fix the problem.

    It is a STATE and not a dialog because there is nothing to confirm: the app cannot
    proceed until a folder is named, and the three ways to name one are on screen.
  -->
  <Border Background="{DynamicResource RmBackgroundSurfaceBrush}"
          BorderBrush="{DynamicResource RmBorderSubtleBrush}"
          BorderThickness="1" CornerRadius="4" ClipToBounds="True"
          AutomationProperties.Name="RimWorld was not found">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="14" Margin="24,32">

        <!-- Shape AND colour, the same danger circle the destructive confirm uses. -->
        <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center"
                Background="{DynamicResource RmDangerTintBrush}"
                BorderBrush="{DynamicResource RmDangerBrush}" BorderThickness="1">
          <PathIcon Data="{StaticResource RmIconError}" Width="20" Height="20"
                    Foreground="{DynamicResource RmDangerBrush}" />
        </Border>

        <TextBlock Text="RimWorld is not where it used to be" HorizontalAlignment="Center"
                   FontSize="{DynamicResource RmFontSizeTitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource RmTextPrimaryBrush}" />

        <!--
          Two blocks rather than one string: the first sentence changes with what the
          probe found, the second never does. Both wrap inside a MaxWidth, and both say
          where they sit — a MaxWidth'd TextBlock left on the default Stretch is centred
          by the layout system somewhere nobody asked for.
        -->
        <StackPanel Spacing="2" MaxWidth="420" HorizontalAlignment="Center">
          <TextBlock Text="{Binding GameMissingDetail}" Classes="sec"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="Your load order and snapshots are safe — we just cannot read the mods."
                     Classes="sec" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <!-- The stale path, in mono and unelided: the difference is usually one
             segment, and eliding is what would hide it. -->
        <TextBlock Text="{Binding GameMissingPath}" Classes="mono ter"
                   TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="420" HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                    Margin="0,4,0,0">
          <Button Classes="accent" Content="Locate folder…"
                  Command="{Binding LocateGameFolderCommand}" />
          <Button Classes="quiet" Content="Auto-detect"
                  Command="{Binding AutoDetectGameFolderCommand}" />

          <!--
            This was "Switch instance", and removing instances made it dead logic rather
            than merely renamed: with one install every instance record held the SAME
            paths, so switching between them could never fix a missing game folder. And
            switching modlist certainly cannot — a modlist says which mods, never where
            the game is.

            Settings ▸ Paths is the route that actually fixes this, and it opens there:
            Paths is the first page.
          -->
          <Button Classes="quiet" Content="Open settings"
                  Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="Edit the game, config and Workshop folders" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
