<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RimManager.App.ViewModels"
             x:Class="RimManager.App.Views.Shell.ScanStateView"
             x:DataType="vm:MainWindowViewModel"
             IsVisible="{Binding IsScanning}">
  <!--
    2k · STATE, LOADING — the whole window since N7d (owner's call). It covered only
    the panes with the chrome left live, and the card even said so; in practice a
    toolbar that takes clicks while the lists are mid-rebuild is an invitation to act
    on a half truth, so the state now blocks by covering. Opaque, full-bleed, and
    hit-testable on purpose: covering is one rule, disabling is thirty flags.

    It also carries the app mark. Cold start to a window on screen is 963ms, and that
    963ms IS Avalonia initialising, so a splash could neither be shown earlier nor for
    long enough to read. The scan that follows it lasts long enough to be worth
    explaining, so the brand moment lives here, where it is attached to something true.
  -->
  <Border Background="{DynamicResource RmBackgroundCanvasBrush}"
          AutomationProperties.Name="Loading">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="24">

      <!-- Theme-bound (T4, S-BRAND): the hub swaps the mark with the theme. -->
      <Image Source="{Binding ThemeMark}"
             Width="64" Height="64" HorizontalAlignment="Center" />

      <!-- Bound, not hardcoded. A modlist switch spends most of its time copying
           Mod_*.xml files in and out of the game's config folder, and while it did that
           this title said "Reading mod folders…" — the one phase the fixed title was
           wrong for was the one the user was actually waiting on. -->
      <TextBlock Text="{Binding LoadPhaseLabel}" HorizontalAlignment="Center"
                 FontSize="{DynamicResource RmFontSizeTitle}" FontWeight="SemiBold"
                 Foreground="{DynamicResource RmTextPrimaryBrush}" />

      <!--
        "218 / 342 · workshop/content/294100". Both halves are bounded strings — the
        count by arithmetic, the path by ShortRoot plus an elide in the STRING — so a
        horizontal StackPanel handing its children infinite width cannot push this
        line past the panel edge. Nothing here wraps, and nothing here needs to.
      -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
        <TextBlock Text="{Binding ScanCountText}" Classes="mono sec" />
        <TextBlock Text=" · " Classes="mono ter" IsVisible="{Binding HasScanCount}" />
        <TextBlock Text="{Binding ScanPathText}" Classes="mono ter" />
      </StackPanel>

      <ProgressBar Classes="scan" Width="260"
                   Minimum="0" Maximum="1"
                   Value="{Binding ScanFraction}"
                   IsIndeterminate="{Binding ScanIsIndeterminate}"
                   HorizontalAlignment="Center"
                   AutomationProperties.Name="Scan progress" />

      <!-- The old line said "nothing is blocked" — true of the markup, false of the
           product: clicking a menu over half-built lists acts on a half truth. Now
           that the state covers the window, the line states the new contract. -->
      <TextBlock Text="The window unlocks when the list is ready."
                 HorizontalAlignment="Center" Classes="small ter" />

      <!-- There is deliberately no escape hatch here any more. One was added when the
           conflict phase could only draw an indeterminate stripe, on the grounds that
           eighteen cold seconds with no way out is a hang with a logo. Every phase now
           reports a real fraction and a live count, which answers the same worry better:
           a bar moving visibly through 214 / 292 is not a hang, and escaping a wait you
           can watch ending is a control nobody reaches for. -->
    </StackPanel>
  </Border>
</UserControl>
