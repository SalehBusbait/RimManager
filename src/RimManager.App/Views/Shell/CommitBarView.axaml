<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RimManager.App.ViewModels"
             x:Class="RimManager.App.Views.Shell.CommitBarView"
             x:DataType="vm:MainWindowViewModel">
  <!--
    Apply — an INLINE 44px bar directly under the toolbar, never a modal (design
    non-negotiable #4; 2i-2). Only three surfaces in the whole app are modal, and
    each blocks because a wrong click writes to disk or destroys data.

    Two things changed once it was used in anger. It sat at the BOTTOM of the window,
    so the question appeared as far from the "Apply to game" button as the layout
    allowed; it is under that button now. And it appeared on EVERY apply, asking
    "Write 73 mods to ModsConfig.xml?" — a question with one answer, which is how a
    confirmation turns into a second click. It appears only when there is something to
    say, and ApplyConcerns records what counts and what deliberately does not.

    The rule is at the TOP (T5, S-COMMIT — the accepted design's call, reversing the
    bottom-rule reasoning that stood here): the 2px accent/danger line separates the
    bar from the toolbar whose button raised it, which is where the eye arrives from.

    The blocking variant is the SAME bar with a danger rule, the reason, and
    "Apply anyway" — rather than a different surface, so the user's eye does not have
    to relearn where the answer lives. The icon is always present now: the bar only
    ever appears WITH a question, and a question wears a face — info at accent for
    the ordinary stop, the warning triangle at danger when blocked.
  -->
  <Border Height="{DynamicResource RmCommitBarHeight}"
          Background="{DynamicResource RmBackgroundElevatedBrush}"
          BorderThickness="0,2,0,0"
          Classes.blocked="{Binding Commit.IsBlocked}"
          IsVisible="{Binding Commit.IsVisible}">
    <Border.Styles>
      <!-- Accent top rule normally; danger when blocking warnings exist. -->
      <Style Selector="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource RmAccentBrush}" />
      </Style>
      <Style Selector="Border.blocked">
        <Setter Property="BorderBrush" Value="{DynamicResource RmDangerBrush}" />
      </Style>
    </Border.Styles>
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
      <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0"
                VerticalAlignment="Center"
                Data="{StaticResource RmIconInfo}"
                Foreground="{DynamicResource RmAccentBrush}"
                IsVisible="{Binding !Commit.IsBlocked}" />
      <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0"
                VerticalAlignment="Center"
                Data="{StaticResource RmIconWarning}"
                Foreground="{DynamicResource RmDangerBrush}"
                IsVisible="{Binding Commit.IsBlocked}" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="{Binding Commit.Title}" FontWeight="SemiBold" Classes="pri" />
        <!-- The backup filename and diff summary: the reassurance that makes an
             inline bar enough. -->
        <TextBlock Text="{Binding Commit.Detail}" Classes="small ter"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Commit.Detail}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="quiet" Content="Cancel" Command="{Binding CancelCommitCommand}" />
        <Button Classes="quiet" Content="Show warnings" Command="{Binding ShowBlockingWarningsCommand}"
                IsVisible="{Binding Commit.IsBlocked}" />
        <Button Classes="accent" Content="{Binding Commit.ConfirmLabel}"
                Command="{Binding ConfirmCommitCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
