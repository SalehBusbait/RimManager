<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RimManager.App</RootNamespace>
    <AssemblyName>RimManager</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The Win32 exe icon: Explorer, the taskbar and Alt-Tab read this, not the
         window's own Icon. Generated by assets/brand/make-icon.py. -->
    <ApplicationIcon>..\..\assets\brand\rimmanager.ico</ApplicationIcon>

    <!-- Compiled bindings on by default (spec §2). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimManager.Core\RimManager.Core.csproj" />
    <ProjectReference Include="..\RimManager.Storage\RimManager.Storage.csproj" />
    <ProjectReference Include="..\RimManager.Integrations\RimManager.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
