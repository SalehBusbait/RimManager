<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Drop Pods Light (light) — GENERATED by assets/themes/generate-tokens.py from
    assets/themes/tokens.css. Do not hand-edit: change the CSS and rerun
    (provenance of the tokens is in assets/themes/SOURCES.md).

    THE RULE (design non-negotiable #1): every colour in the app is a
    {DynamicResource Rm*} pointing at a dictionary like this one. Key parity
    across all ten dictionaries is test-enforced (ThemeTokenTests).
  -->
  <SolidColorBrush x:Key="RmBackgroundCanvasBrush" Color="#D9E5EE" />
  <SolidColorBrush x:Key="RmBackgroundSurfaceBrush" Color="#EDF1F4" />
  <SolidColorBrush x:Key="RmBackgroundAltBrush" Color="#E5EBEF" />
  <SolidColorBrush x:Key="RmBackgroundElevatedBrush" Color="#F5F8FA" />
  <SolidColorBrush x:Key="RmBackgroundZebraBrush" Color="#E0E6EB" />
  <SolidColorBrush x:Key="RmBackgroundHoverBrush" Color="#D4DADF" />
  <SolidColorBrush x:Key="RmBackgroundSelectedBrush" Color="#E2D5C9" />
  <SolidColorBrush x:Key="RmBackgroundSelectedIdleBrush" Color="#D7D9DB" />
  <SolidColorBrush x:Key="RmBorderDividerBrush" Color="#D9DFE3" />
  <SolidColorBrush x:Key="RmBorderSubtleBrush" Color="#CBD2D7" />
  <SolidColorBrush x:Key="RmBorderStrongBrush" Color="#A8AFB4" />
  <SolidColorBrush x:Key="RmScrollThumbBrush" Color="#9DA4A9" />
  <SolidColorBrush x:Key="RmTextPrimaryBrush" Color="#1C242E" />
  <SolidColorBrush x:Key="RmTextSecondaryBrush" Color="#5D6875" />
  <SolidColorBrush x:Key="RmTextTertiaryBrush" Color="#7E8994" />
  <SolidColorBrush x:Key="RmTextDisabledBrush" Color="#ACB4BE" />
  <SolidColorBrush x:Key="RmAccentBrush" Color="#A9661E" />
  <SolidColorBrush x:Key="RmAccentHoverBrush" Color="#9B5906" />
  <SolidColorBrush x:Key="RmAccentTintBrush" Color="#E3DAD3" />
  <SolidColorBrush x:Key="RmAccentTextBrush" Color="#9D5B0D" />
  <SolidColorBrush x:Key="RmOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="RmBrandBrush" Color="#C9863F" />
  <SolidColorBrush x:Key="RmFocusRingBrush" Color="#9D5B0D" />
  <SolidColorBrush x:Key="RmSuccessBrush" Color="#07754A" />
  <SolidColorBrush x:Key="RmSuccessTintBrush" Color="#DFE8E8" />
  <SolidColorBrush x:Key="RmWarningBrush" Color="#806308" />
  <SolidColorBrush x:Key="RmWarningTintBrush" Color="#E5E7E5" />
  <SolidColorBrush x:Key="RmDangerBrush" Color="#BE3036" />
  <SolidColorBrush x:Key="RmDangerTintBrush" Color="#ECE2E4" />
  <SolidColorBrush x:Key="RmDangerHoverBrush" Color="#AE1E29" />
  <SolidColorBrush x:Key="RmInfoBrush" Color="#2D69AB" />
  <SolidColorBrush x:Key="RmInfoTintBrush" Color="#E0E8EF" />
  <SolidColorBrush x:Key="RmHarmonyBrush" Color="#3566BB" />
  <SolidColorBrush x:Key="RmHarmonyTintBrush" Color="#E0E8F1" />
  <SolidColorBrush x:Key="RmPalette0Brush" Color="#2B64A0" />
  <SolidColorBrush x:Key="RmPalette1Brush" Color="#047142" />
  <SolidColorBrush x:Key="RmPalette2Brush" Color="#7C5D09" />
  <SolidColorBrush x:Key="RmPalette3Brush" Color="#AF3834" />
  <SolidColorBrush x:Key="RmPalette4Brush" Color="#6F4FB2" />
  <SolidColorBrush x:Key="RmPalette5Brush" Color="#566271" />
  <SolidColorBrush x:Key="RmFavouriteBrush" Color="#AF349A" />
  <SolidColorBrush x:Key="RmFavouriteBgBrush" Color="#EADAE7" />
  <SolidColorBrush x:Key="RmPalette0BgBrush" Color="#D4E0EC" />
  <SolidColorBrush x:Key="RmPalette1BgBrush" Color="#D4E3DE" />
  <SolidColorBrush x:Key="RmPalette2BgBrush" Color="#E0DED7" />
  <SolidColorBrush x:Key="RmPalette3BgBrush" Color="#EADADA" />
  <SolidColorBrush x:Key="RmPalette4BgBrush" Color="#DCDCEE" />
  <SolidColorBrush x:Key="RmPalette5BgBrush" Color="#D8DDE2" />
  <SolidColorBrush x:Key="RmSrcCoreFgBrush" Color="#566271" />
  <SolidColorBrush x:Key="RmSrcCoreBgBrush" Color="#DADFE3" />
  <SolidColorBrush x:Key="RmSrcDlcFgBrush" Color="#7E5E02" />
  <SolidColorBrush x:Key="RmSrcDlcBgBrush" Color="#E1E0DA" />
  <SolidColorBrush x:Key="RmSrcWorkshopFgBrush" Color="#2B64A0" />
  <SolidColorBrush x:Key="RmSrcWorkshopBgBrush" Color="#D5E0EA" />
  <SolidColorBrush x:Key="RmSrcLocalFgBrush" Color="#047142" />
  <SolidColorBrush x:Key="RmSrcLocalBgBrush" Color="#D4E1DD" />
  <SolidColorBrush x:Key="RmSrcGitFgBrush" Color="#965202" />
  <SolidColorBrush x:Key="RmSrcGitBgBrush" Color="#E7E1DC" />
  <SolidColorBrush x:Key="RmSrcPinnedFgBrush" Color="#6F4FB2" />
  <SolidColorBrush x:Key="RmSrcPinnedBgBrush" Color="#DDDDED" />
  <SolidColorBrush x:Key="RmDiffAddedBrush" Color="#D2E0DC" />
  <SolidColorBrush x:Key="RmDiffRemovedBrush" Color="#EBD9DA" />
  <SolidColorBrush x:Key="RmScrimBrush" Color="#521A2230" />
  <!-- The info-pane drawer's leftward shadow — geometry is the app's, only the
       colour weight comes from the design's shadow token (see generator header). -->
  <BoxShadows x:Key="RmDrawerShadow">-8 0 24 0 #29000000</BoxShadows>
  <!-- The command-palette shell's downward shadow (S-LEGEND/S-SELECTOR cite the
       palette as the reference shell, and it shipped shadowless). Same colour
       weight, centred-overlay geometry. -->
  <BoxShadows x:Key="RmFlyoutShadow">0 8 24 0 #29000000</BoxShadows>
  <!-- Fluent keys for the un-retemplated controls (Slider, plain RadioButton);
       AccentPalette.Derive wrote these at runtime before it was retired. -->
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#A9661E" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#9B5906" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#A9661E" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#A9661E" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#9B5906" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#A9661E" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#A9661E" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#9B5906" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#A9661E" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#A9661E" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
</ResourceDictionary>
