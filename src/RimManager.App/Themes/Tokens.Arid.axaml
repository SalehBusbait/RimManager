<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Arid Rim (light) — GENERATED by assets/themes/generate-tokens.py from
    assets/themes/tokens.css. Do not hand-edit: change the CSS and rerun
    (provenance of the tokens is in assets/themes/SOURCES.md).

    THE RULE (design non-negotiable #1): every colour in the app is a
    {DynamicResource Rm*} pointing at a dictionary like this one. Key parity
    across all ten dictionaries is test-enforced (ThemeTokenTests).
  -->
  <SolidColorBrush x:Key="RmBackgroundCanvasBrush" Color="#E6D6AE" />
  <SolidColorBrush x:Key="RmBackgroundSurfaceBrush" Color="#F5F0E5" />
  <SolidColorBrush x:Key="RmBackgroundAltBrush" Color="#F0E9DA" />
