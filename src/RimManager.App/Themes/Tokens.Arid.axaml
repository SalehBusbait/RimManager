  <!-- The info-pane drawer's leftward shadow — geometry is the app's, only the
       colour weight comes from the design's shadow token (see generator header). -->
  <BoxShadows x:Key="RmDrawerShadow">-8 0 24 0 #29000000</BoxShadows>
  <!-- The command-palette shell's downward shadow (S-LEGEND/S-SELECTOR cite the
       palette as the reference shell, and it shipped shadowless). Same colour
       weight, centred-overlay geometry. -->
  <BoxShadows x:Key="RmFlyoutShadow">0 8 24 0 #29000000</BoxShadows>
  <!-- Fluent keys for the un-retemplated controls (Slider, plain RadioButton);
       AccentPalette.Derive wrote these at runtime before it was retired. -->
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#B24E24" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#A34013" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B24E24" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#B24E24" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#A34013" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#B24E24" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#B24E24" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#A34013" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#B24E24" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#B24E24" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
</ResourceDictionary>
