<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Drop Pods Dark (dark) — GENERATED by assets/themes/generate-tokens.py from
    assets/themes/tokens.css. Do not hand-edit: change the CSS and rerun
    (provenance of the tokens is in assets/themes/SOURCES.md).

    THE RULE (design non-negotiable #1): every colour in the app is a
    {DynamicResource Rm*} pointing at a dictionary like this one. Key parity
    across all ten dictionaries is test-enforced (ThemeTokenTests).
  -->
  <SolidColorBrush x:Key="RmBackgroundCanvasBrush" Color="#161E29" />
  <SolidColorBrush x:Key="RmBackgroundSurfaceBrush" Color="#1C242F" />
  <SolidColorBrush x:Key="RmBackgroundAltBrush" Color="#19212C" />
  <SolidColorBrush x:Key="RmBackgroundElevatedBrush" Color="#242C38" />
  <SolidColorBrush x:Key="RmBackgroundZebraBrush" Color="#202934" />
  <SolidColorBrush x:Key="RmBackgroundHoverBrush" Color="#2A333F" />
  <SolidColorBrush x:Key="RmBackgroundSelectedBrush" Color="#463D37" />
  <SolidColorBrush x:Key="RmBackgroundSelectedIdleBrush" Color="#2F3337" />
  <SolidColorBrush x:Key="RmBorderDividerBrush" Color="#212832" />
  <SolidColorBrush x:Key="RmBorderSubtleBrush" Color="#29303A" />
  <SolidColorBrush x:Key="RmBorderStrongBrush" Color="#3B424C" />
  <SolidColorBrush x:Key="RmScrollThumbBrush" Color="#495059" />
  <SolidColorBrush x:Key="RmTextPrimaryBrush" Color="#E4E9EF" />
  <SolidColorBrush x:Key="RmTextSecondaryBrush" Color="#8E99A8" />
  <SolidColorBrush x:Key="RmTextTertiaryBrush" Color="#6C7582" />
  <SolidColorBrush x:Key="RmTextDisabledBrush" Color="#4C535C" />
  <SolidColorBrush x:Key="RmAccentBrush" Color="#C9863F" />
  <SolidColorBrush x:Key="RmAccentHoverBrush" Color="#DA954F" />
  <SolidColorBrush x:Key="RmAccentTintBrush" Color="#383536" />
  <SolidColorBrush x:Key="RmAccentTextBrush" Color="#C9863F" />
  <SolidColorBrush x:Key="RmOnAccentBrush" Color="#070E18" />
  <SolidColorBrush x:Key="RmBrandBrush" Color="#C9863F" />
  <SolidColorBrush x:Key="RmFocusRingBrush" Color="#C9863F" />
  <SolidColorBrush x:Key="RmSuccessBrush" Color="#4FBF87" />
  <SolidColorBrush x:Key="RmSuccessTintBrush" Color="#253A3D" />
  <SolidColorBrush x:Key="RmWarningBrush" Color="#E8C64F" />
  <SolidColorBrush x:Key="RmWarningTintBrush" Color="#383C39" />
  <SolidColorBrush x:Key="RmDangerBrush" Color="#F0716A" />
  <SolidColorBrush x:Key="RmDangerTintBrush" Color="#352E37" />
  <SolidColorBrush x:Key="RmDangerHoverBrush" Color="#FE847C" />
  <SolidColorBrush x:Key="RmInfoBrush" Color="#6FA9D8" />
  <SolidColorBrush x:Key="RmInfoTintBrush" Color="#283747" />
  <SolidColorBrush x:Key="RmHarmonyBrush" Color="#7FA9E8" />
  <SolidColorBrush x:Key="RmHarmonyTintBrush" Color="#2A3749" />
  <SolidColorBrush x:Key="RmPalette0Brush" Color="#64A1DD" />
  <SolidColorBrush x:Key="RmPalette1Brush" Color="#58B57E" />
  <SolidColorBrush x:Key="RmPalette2Brush" Color="#D9A84C" />
  <SolidColorBrush x:Key="RmPalette3Brush" Color="#ED7C75" />
  <SolidColorBrush x:Key="RmPalette4Brush" Color="#AB8FE0" />
  <SolidColorBrush x:Key="RmPalette5Brush" Color="#939EAC" />
  <SolidColorBrush x:Key="RmFavouriteBrush" Color="#ED75D9" />
  <SolidColorBrush x:Key="RmFavouriteBgBrush" Color="#3B3239" />
  <SolidColorBrush x:Key="RmPalette0BgBrush" Color="#273648" />
  <SolidColorBrush x:Key="RmPalette1BgBrush" Color="#263A3C" />
  <SolidColorBrush x:Key="RmPalette2BgBrush" Color="#383938" />
  <SolidColorBrush x:Key="RmPalette3BgBrush" Color="#3B323A" />
  <SolidColorBrush x:Key="RmPalette4BgBrush" Color="#313448" />
  <SolidColorBrush x:Key="RmPalette5BgBrush" Color="#2D3541" />
  <SolidColorBrush x:Key="RmSrcCoreFgBrush" Color="#939EAC" />
  <SolidColorBrush x:Key="RmSrcCoreBgBrush" Color="#2C3440" />
  <SolidColorBrush x:Key="RmSrcDlcFgBrush" Color="#D9B45B" />
  <SolidColorBrush x:Key="RmSrcDlcBgBrush" Color="#353838" />
  <SolidColorBrush x:Key="RmSrcWorkshopFgBrush" Color="#64A1DD" />
  <SolidColorBrush x:Key="RmSrcWorkshopBgBrush" Color="#263546" />
  <SolidColorBrush x:Key="RmSrcLocalFgBrush" Color="#58B57E" />
  <SolidColorBrush x:Key="RmSrcLocalBgBrush" Color="#25373B" />
  <SolidColorBrush x:Key="RmSrcGitFgBrush" Color="#E08A50" />
  <SolidColorBrush x:Key="RmSrcGitBgBrush" Color="#373336" />
  <SolidColorBrush x:Key="RmSrcPinnedFgBrush" Color="#AB8FE0" />
  <SolidColorBrush x:Key="RmSrcPinnedBgBrush" Color="#2F3346" />
  <SolidColorBrush x:Key="RmDiffAddedBrush" Color="#23363A" />
  <SolidColorBrush x:Key="RmDiffRemovedBrush" Color="#362F37" />
  <SolidColorBrush x:Key="RmScrimBrush" Color="#8C05070B" />
  <!-- The info-pane drawer's leftward shadow — geometry is the app's, only the
       colour weight comes from the design's shadow token (see generator header). -->
  <BoxShadows x:Key="RmDrawerShadow">-8 0 24 0 #80000000</BoxShadows>
  <!-- The command-palette shell's downward shadow (S-LEGEND/S-SELECTOR cite the
       palette as the reference shell, and it shipped shadowless). Same colour
       weight, centred-overlay geometry. -->
  <BoxShadows x:Key="RmFlyoutShadow">0 8 24 0 #80000000</BoxShadows>
  <!-- Fluent keys for the un-retemplated controls (Slider, plain RadioButton);
       AccentPalette.Derive wrote these at runtime before it was retired. -->
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#C9863F" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#DA954F" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#C9863F" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#C9863F" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DA954F" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#C9863F" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#C9863F" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#DA954F" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#C9863F" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#C9863F" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#070E18" />
</ResourceDictionary>
