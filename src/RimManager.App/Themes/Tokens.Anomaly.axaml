  <SolidColorBrush x:Key="RmBackgroundSelectedBrush" Color="#302947" />
  <SolidColorBrush x:Key="RmBackgroundSelectedIdleBrush" Color="#1E1D21" />
  <SolidColorBrush x:Key="RmBorderDividerBrush" Color="#141118" />
  <SolidColorBrush x:Key="RmBorderSubtleBrush" Color="#1B1920" />
  <SolidColorBrush x:Key="RmBorderStrongBrush" Color="#2C2931" />
  <SolidColorBrush x:Key="RmScrollThumbBrush" Color="#39363D" />
  <SolidColorBrush x:Key="RmTextPrimaryBrush" Color="#E6E0EE" />
  <SolidColorBrush x:Key="RmTextSecondaryBrush" Color="#837896" />
  <SolidColorBrush x:Key="RmTextTertiaryBrush" Color="#665D77" />
