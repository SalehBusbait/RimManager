  <!-- The info-pane drawer's leftward shadow — geometry is the app's, only the
       colour weight comes from the design's shadow token (see generator header). -->
  <BoxShadows x:Key="RmDrawerShadow">-8 0 24 0 #80000000</BoxShadows>
  <!-- The command-palette shell's downward shadow (S-LEGEND/S-SELECTOR cite the
       palette as the reference shell, and it shipped shadowless). Same colour
       weight, centred-overlay geometry. -->
  <BoxShadows x:Key="RmFlyoutShadow">0 8 24 0 #80000000</BoxShadows>
  <!-- Fluent keys for the un-retemplated controls (Slider, plain RadioButton);
       AccentPalette.Derive wrote these at runtime before it was retired. -->
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#9FC3E8" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#AFD3F9" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#9FC3E8" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#9FC3E8" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#AFD3F9" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#9FC3E8" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#9FC3E8" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#AFD3F9" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#9FC3E8" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#9FC3E8" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#0E0A19" />
</ResourceDictionary>
