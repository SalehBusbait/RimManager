  <SolidColorBrush x:Key="RmBackgroundSelectedIdleBrush" Color="#383541" />
  <SolidColorBrush x:Key="RmBorderDividerBrush" Color="#2F2743" />
  <SolidColorBrush x:Key="RmBorderSubtleBrush" Color="#372F4C" />
  <SolidColorBrush x:Key="RmBorderStrongBrush" Color="#49425E" />
  <SolidColorBrush x:Key="RmScrollThumbBrush" Color="#564F6B" />
  <SolidColorBrush x:Key="RmTextPrimaryBrush" Color="#F0E9F8" />
  <SolidColorBrush x:Key="RmTextSecondaryBrush" Color="#A793C9" />
  <SolidColorBrush x:Key="RmTextTertiaryBrush" Color="#82709F" />
