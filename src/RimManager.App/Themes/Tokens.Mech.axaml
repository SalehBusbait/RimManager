  <SolidColorBrush x:Key="RmBorderDividerBrush" Color="#1E2125" />
  <SolidColorBrush x:Key="RmBorderSubtleBrush" Color="#26292D" />
  <SolidColorBrush x:Key="RmBorderStrongBrush" Color="#383A3F" />
  <SolidColorBrush x:Key="RmScrollThumbBrush" Color="#45474C" />
  <SolidColorBrush x:Key="RmTextPrimaryBrush" Color="#E2E7EC" />
  <SolidColorBrush x:Key="RmTextSecondaryBrush" Color="#8A94A0" />
