<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Glitterworld (dark) — GENERATED by assets/themes/generate-tokens.py from
    assets/themes/tokens.css. Do not hand-edit: change the CSS and rerun
    (provenance of the tokens is in assets/themes/SOURCES.md).

    THE RULE (design non-negotiable #1): every colour in the app is a
    {DynamicResource Rm*} pointing at a dictionary like this one. Key parity
    across all ten dictionaries is test-enforced (ThemeTokenTests).
  -->
  <SolidColorBrush x:Key="RmBackgroundCanvasBrush" Color="#0A1522" />
  <SolidColorBrush x:Key="RmBackgroundSurfaceBrush" Color="#101B27" />
  <SolidColorBrush x:Key="RmBackgroundAltBrush" Color="#0D1825" />
  <SolidColorBrush x:Key="RmBackgroundElevatedBrush" Color="#172330" />
  <SolidColorBrush x:Key="RmBackgroundZebraBrush" Color="#141F2D" />
  <SolidColorBrush x:Key="RmBackgroundHoverBrush" Color="#1D2937" />
  <SolidColorBrush x:Key="RmBackgroundSelectedBrush" Color="#1A4755" />
  <SolidColorBrush x:Key="RmBackgroundSelectedIdleBrush" Color="#262A2F" />
  <SolidColorBrush x:Key="RmBorderDividerBrush" Color="#151F2A" />
  <SolidColorBrush x:Key="RmBorderSubtleBrush" Color="#1D2733" />
  <SolidColorBrush x:Key="RmBorderStrongBrush" Color="#2E3844" />
  <SolidColorBrush x:Key="RmScrollThumbBrush" Color="#3C4551" />
  <SolidColorBrush x:Key="RmTextPrimaryBrush" Color="#E4EEF4" />
  <SolidColorBrush x:Key="RmTextSecondaryBrush" Color="#7FA8B8" />
  <SolidColorBrush x:Key="RmTextTertiaryBrush" Color="#5F8390" />
  <SolidColorBrush x:Key="RmTextDisabledBrush" Color="#455F69" />
  <SolidColorBrush x:Key="RmAccentBrush" Color="#4FD8E0" />
  <SolidColorBrush x:Key="RmAccentHoverBrush" Color="#63E9F1" />
  <SolidColorBrush x:Key="RmAccentTintBrush" Color="#1C3844" />
  <SolidColorBrush x:Key="RmAccentTextBrush" Color="#4FD8E0" />
  <SolidColorBrush x:Key="RmOnAccentBrush" Color="#050E1A" />
